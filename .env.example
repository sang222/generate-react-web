MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ai_dev_team
MONGO_RUNS_COLLECTION=runs
MONGO_AGENT_PROFILES_COLLECTION=agent_profiles
MONGO_AGENT_MEMORIES_COLLECTION=agent_memories
OLLAMA_HOST=http://127.0.0.1:11434
TRACE_AGENTS=1
TRACE_MAX_CHARS=20000

# Role -> model mapping (local Ollama by default)
DEFAULT_MODEL=glm4
PM_MODEL=glm4
ARCHITECT_MODEL=glm4
DEVELOPER_MODEL=qwen2.5-coder:7b
QA_MODEL=qwen2.5-coder:7b
LEAD_MODEL=glm4

# Optional cloud Qwen settings
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_CLOUD_MODEL=qwen-plus
